# Keycloak + E2 API (optional — for “From API” approved TP sync)
# Copy to `.env` in the project root for local dev.

# Required for login: realm name on your Keycloak host
KEYCLOAK_REALM=

KEYCLOAK_BASE_URL=https://auth-dev-e2.saal.ai/auth
KEYCLOAK_CLIENT_ID=e2-student-portal-sso
KEYCLOAK_REDIRECT_URI=http://localhost/oauth/callback

E2_API_BASE_URL=https://dev-e2.saal.ai/e2-question-bank
